        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.2",
        "vite": "^8.0.0",
        "vitest": "^3.2.4",
        "vue-tsc": "^3.0.6"
